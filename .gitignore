# 依赖
node_modules/

# 运行时数据（本地库文件，不入库）
server/data/
data/

# 本地私有配置（含 API Key）
config.json
server/config.json
# 配置备份同样是密钥（实测 server/config.json.bak-2144 里就有 apiKey）——
# 只忽略 config.json 是不够的: 备份文件名带时间后缀, 正则要覆盖到
config.json.bak*
*.bak-*
# 随手放的本机密钥文件（无任何代码读它, 是手抄的 API Key）
dsapi.txt

# 日志
*.log
npm-debug.log*

# 本地 AI 工作记忆（仅本机使用，如要随仓库走请删掉这一行）
.workbuddy/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# .sim 运行产物 (工具脚本入库, 产物不入库)
.sim/*.png
.sim/injection-live.txt
